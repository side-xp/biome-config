{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "extends": ["./biome.json"],
  "linter": {
    "rules": {
      "complexity": {
        "noRedundantDefaultExport": "error"
      },
      "style": {
        "useNodejsImportProtocol": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useErrorCause": "error",
        "useGlobalThis": "error"
      },
      "suspicious": {
        "noConsole": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.js", "**/*.spec.ts", "**/*.spec.js", "scripts/*.js", "scripts/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
